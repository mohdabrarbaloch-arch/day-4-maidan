# ── App ──────────────────────────────────────────────────────────
APP_NAME=Maidan
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank in development, an ephemeral per-process key is used and tokens
# stop working on restart. In production the app refuses to start without it.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./maidan.db
# PostgreSQL (docker-compose provides this):
# DATABASE_URL=postgresql+psycopg2://maidan:maidan@db:5432/maidan
# On Vercel the filesystem is read-only except /tmp, so SQLite must live there:
# DATABASE_URL=sqlite:////tmp/maidan.db

# ── CORS ─────────────────────────────────────────────────────────
# "*" for local development. In production list your origins, comma separated:
# CORS_ORIGINS=https://maidan.example.com,https://www.maidan.example.com
CORS_ORIGINS=*

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ── Cloud backend (optional) ─────────────────────────────────────
# The local engine needs no keys at all. These only enable the cloud toggle.
# Without them the API returns 503 with an explanation rather than faking a reply.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Limits ───────────────────────────────────────────────────────
MAX_PROMPT_CHARS=8000
MAX_NEW_TOKENS=400
